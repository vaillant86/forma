[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://bg.tscn" id="2_bg"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" parent="." instance=ExtResource("2_bg")]

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 18
alignment = 1

[node name="Title" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 60
text = "FORMA"
horizontal_alignment = 1
vertical_alignment = 1

[node name="BtnNuovaPartita" type="Button" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
focus_mode = Control.FOCUS_ALL
theme_override_font_sizes/font_size = 20
text = "NEW GAME"

[node name="BtnContinua" type="Button" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
focus_mode = Control.FOCUS_ALL
theme_override_font_sizes/font_size = 20
text = "CONTINUE"

[node name="BtnEsci" type="Button" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
focus_mode = Control.FOCUS_ALL
theme_override_font_sizes/font_size = 20
text = "EXIT"

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="BtnAudio" type="Button" parent="MarginContainer"]
layout_mode = 2
size_flags_horizontal = 8
focus_mode = Control.FOCUS_ALL
theme_override_font_sizes/font_size = 18
text = "AUDIO: ON"

[connection signal="pressed" from="CenterContainer/VBoxContainer/BtnNuovaPartita" to="." method="_on_btn_nuova_partita_pressed"]
[connection signal="pressed" from="CenterContainer/VBoxContainer/BtnContinua" to="." method="_on_btn_continua_pressed"]
[connection signal="pressed" from="CenterContainer/VBoxContainer/BtnEsci" to="." method="_on_btn_esci_pressed"]
[connection signal="pressed" from="MarginContainer/BtnAudio" to="." method="_on_btn_audio_pressed"]
